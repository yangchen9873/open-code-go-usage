{
  "manifest_version": 3,
  "name": "AI 用量监控",
  "version": "0.3.0",
  "description": "在浏览器工具栏查看 OpenCode Go、Command Code GOAT 和 DeepSeek 的用量。",
  "permissions": ["tabs", "cookies", "storage", "scripting"],
  "host_permissions": ["https://opencode.ai/*", "https://commandcode.ai/*", "https://api.commandcode.ai/*", "https://*.deepseek.com/*"],
  "action": {
    "default_title": "AI 用量监控",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
